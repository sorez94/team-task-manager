// Prisma schema for the task manager app.
// Local-first SQLite database — no external services required.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Status {
  BACKLOG
  TODO
  DOING
  BLOCKED
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskType {
  BUG
  TASK
}

// Which side(s) of the stack a task touches. A task can span more than one
// area, so this isn't a column type SQLite has (no scalar-list support) —
// see `areas` below, which stores it as a comma-separated list of these.
enum TaskArea {
  FRONTEND
  BACKEND
  DESIGN
  PRODUCT
}

model Task {
  id               String    @id @default(cuid())
  title            String
  description      String?
  type             TaskType  @default(BUG)
  // Comma-separated TaskArea values, e.g. "FRONTEND,DESIGN" — null/empty
  // means unspecified. Parsed/serialized via parseAreas/serializeAreas in
  // lib/utils.ts rather than stored as a native list (unsupported on SQLite).
  areas            String?
  status           Status    @default(TODO)
  priority         Priority  @default(MEDIUM)
  dueDate          DateTime?
  // Comma-separated list of free-text assignee names, e.g. "Amelia Chen,Marcus Reid"
  // — null/empty means unassigned. A task can have more than one assignee, so
  // this isn't a single scalar column any more than `areas` is; it's parsed/
  // serialized via parseAssignees/serializeAssignees in lib/utils.ts.
  assignees        String?
  // Time logged on this task, in minutes. Entered/displayed compactly (e.g.
  // "2h", "45m", "1d") via formatDuration/parseDuration in lib/utils.ts.
  timeSpentMinutes Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attachments      Attachment[]

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([areas])
  @@index([assignees])
  @@index([dueDate])
  @@index([createdAt])
}

// An image attached to a task. Bytes live in this row (BLOB) rather than on
// disk — this app runs on Vercel in production, where serverless functions
// have no persistent filesystem (see the driver-adapter note on prisma.ts),
// so the database is the only storage that survives a deploy.
model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([taskId])
}
