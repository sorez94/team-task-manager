// Prisma schema for the task manager app.
// Local-first SQLite database — no external services required.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskType {
  BUG
  TASK
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        TaskType  @default(BUG)
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  assignee    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([dueDate])
  @@index([createdAt])
}
